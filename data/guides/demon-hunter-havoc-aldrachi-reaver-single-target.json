    "actions.meta+=/throw_glaive,if=debuff.essence_break.down&variable.use_filler&!talent.furious_throws&(!buff.out_of_range.up|buff.out_of_range.remains>gcd.max)&(buff.metamorphosis.remains>5|active_enemies>3)"
  ]
}